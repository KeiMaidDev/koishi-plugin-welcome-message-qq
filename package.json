{
  "name": "koishi-plugin-welcome-message-qq",
  "description": "QQ 群成员入群欢迎、离群通知与原生 Markdown 命令按钮插件",
  "version": "0.1.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "dist"
  ],
  "scripts": {
    "build:client": "esbuild client/index.ts --bundle --format=esm --platform=browser --target=es2020 --charset=utf8 --outfile=dist/index.js --external:vue --external:@koishijs/client",
    "test": "tsx --test tests/*.spec.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json"
  },
  "license": "MIT",
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "qq",
    "qq-group",
    "welcome-message",
    "guild-member",
    "markdown"
  ],
  "koishi": {
    "public": [
      "dist"
    ],
    "service": {
      "optional": [
        "console"
      ]
    }
  },
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.28.0",
    "koishi": "^4.18.7"
  },
  "devDependencies": {
    "@koishijs/plugin-database-memory": "^3.7.0",
    "@koishijs/plugin-mock": "^2.6.6",
    "esbuild": "^0.23.1",
    "koishi": "^4.18.11",
    "tsx": "^4.16.2",
    "typescript": "^5.6.2"
  }
}
